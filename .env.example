# Environment: development
ENVIRONMENT=production

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-get_random_secret_key
DJANGO_SETTINGS_MODULE=smarten.settings

# Database - PostgreSQL (Neon)
# Use DATABASE_URL for Render
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/smarten?sslmode=require
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smarten
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=your-render-postgres-host
DB_PORT=5432

# Redis - For Channels and WebSocket
REDIS_URL=redis://:your_password@your-redis-host:6379

# MQTT Configuration
MQTT_BROKER=your-mqtt-broker.com  # HiveMQ Cloud, etc.
MQTT_PORT=8883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password
MQTT_USE_TLS=True
MQTT_TOPIC_SENSOR_READ=smarten/sensor/+/read
MQTT_TOPIC_DEVICE_COMMAND=smarten/device/+/command

# Render Deployment
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@smarten.com

# CORS Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
CORS_ALLOWED_ORIGINS=https://your-app.onrender.com,http://localhost:3000

# Supabase (for image storage)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_BUCKET=smarten-mobile-images

# OAuth Google
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret
